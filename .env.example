# Copy to .env and supply your own credential. Never commit .env.

# Which gateway the harness routes through. OpenRouter is the default, so an
# unset value keeps every existing run on the endpoint it always used.
# RSIAGENT_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# OrcaRouter (https://www.orcarouter.ai) — an OpenAI-compatible gateway.
# Select it with RSIAGENT_LLM_PROVIDER=orcarouter, then supply a credential by
# EITHER of the two paths below. Both end in an ordinary sk-orca-… API key that
# belongs to your own account; inference goes to https://api.orcarouter.ai/v1.
#
# 1. Paste an existing key (console: https://www.orcarouter.ai/console/authorized-apps)
# ORCA_API_KEY=
#
# 2. Or authorize in a browser and let the harness store the issued key here:
#      python -m llm.connect login              # paste a code shown on screen
#      python -m llm.connect login --loopback   # local desktop, redirects back
#      python -m llm.connect status             # show what is stored
#      python -m llm.connect logout             # remove it
# The flow is OAuth 2.0 + PKCE (S256), so there is no client secret to keep.
# No refresh grant exists: the key is reused until you revoke it, and a 401 asks
# you to sign in again rather than silently re-authorizing.

# Self-hosted OrcaRouter deployments. ORCA_BASE_URL is one shared origin; the
# explicit overrides win when auth and inference live on separate hosts. Remote
# origins must be https; http is accepted only for loopback development.
# ORCA_BASE_URL=https://gateway.internal.example
# ORCA_AUTH_BASE_URL=https://www.orcarouter.ai
# ORCA_API_BASE_URL=https://api.orcarouter.ai/v1

# Paths default to this checkout and its sibling OSWorld-V2.
# Export path overrides in your shell before invoking a runner:
# RSIAGENT_ROOT=/absolute/path/to/RSIAgent
# OSWORLD_ROOT=/absolute/path/to/OSWorld-V2
# RSIAGENT_ENV_FILE=/absolute/private/path/rsi.env
