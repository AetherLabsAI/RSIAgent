+def _remaining_phase_budget(cfg, *, used_iters: int, used_wall: float,
+                            role: str, sink_root: str,
+                            curriculum_actionless: int | None = None) -> dict:
+    """Keep configured emergency limits across one same-context phase."""
+    if (used_iters >= cfg.max_iters or used_wall >= cfg.wall_clock_secs
+            or (curriculum_actionless is not None
+                and curriculum_actionless >= 3)):
+        record = {"status": "infra", "iters": used_iters,
+                  "wall_secs": used_wall, "role": role,
+                  "max_iters": cfg.max_iters,
+                  "max_wall_secs": cfg.wall_clock_secs}
+        if curriculum_actionless is not None:
+            record["actionless_segments"] = curriculum_actionless
+        _atomic_json(Path(sink_root) / "transport_state.json", record)
+        label = "Curriculum" if curriculum_actionless is not None else role
+        raise E15InfrastructureError(
+            f"{label} exhausted its cumulative transport/liveness "
+            "ceiling; this is not a convergence decision")
+    return {"iters_budget": cfg.max_iters - used_iters,
+            "wall_budget": cfg.wall_clock_secs - used_wall}
+
