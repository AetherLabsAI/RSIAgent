--- /dev/null
+++ b/tests/test_phase_emergency_budget.py
@@ -0,0 +1,145 @@
+import json
+import re
+from types import SimpleNamespace
+
+import pytest
+
+from config.settings import Config
+from explore import e15_loop as loop
+
+
+def run_phase(tmp_path, monkeypatch, kind, steps, *, max_iters=20, wall=60):
+    calls = []
+    guest = {"handoff": ""}
+    monkeypatch.setattr(loop, "_remove_guest_file", lambda *a: None)
+
+    def attempt(prompt, vm, cfg, sink, **kwargs):
+        index = len(calls)
+        assert index < len(steps), "started another segment after the watchdog"
+        calls.append(kwargs)
+        step = steps[index]
+        if step.get("publish"):
+            guest["handoff"] = "READY"
+        history = kwargs["initial_history"] + [
+            {"role": "assistant", "content": f"segment {index}"}]
+        return SimpleNamespace(
+            status=step.get("status", "stalled"),
+            iters=step.get("iters", 1), wall_secs=step.get("wall", 1),
+            programs_run=step.get("programs", 0), looks=0,
+            infra_pause_secs=step.get("pause", 0)), history
+
+    hooks = loop.E15Hooks(
+        run_attempt=attempt, audit_text=lambda *a, **k: [],
+        audit_transcripts=lambda *a, **k: [],
+        read_guest_text=lambda *a: guest["handoff"])
+    options = dict(hooks=hooks, vm=object(),
+                   cfg=Config(max_iters=max_iters, wall_clock_secs=wall),
+                   prompt="public instruction", role="ACTOR",
+                   sink_root=str(tmp_path), target="public instruction",
+                   history=[])
+
+    def run():
+        if kind == "free":
+            return loop._run_free_phase(**options)
+        return loop._run_handoff_phase(
+            **options, handoff_path="/home/user/handoff.md",
+            token_pattern=re.compile("READY"),
+            handoff_parser=lambda text, _: (
+                loop.ParsedHandoff("READY", text, text) if text else None))
+
+    return calls, run
+
+
+@pytest.mark.parametrize("kind", ["handoff", "free"])
+def test_stalled_segments_share_configured_iteration_watchdog(
+        tmp_path, monkeypatch, kind):
+    calls, run = run_phase(tmp_path, monkeypatch, kind,
+                          [{"iters": 3}, {"iters": 2}], max_iters=5)
+    with pytest.raises(loop.E15InfrastructureError,
+                       match="not a convergence decision"):
+        run()
+    assert [c["iters_budget"] for c in calls] == [5, 2]
+    assert calls[1]["initial_history"] == [
+        {"role": "assistant", "content": "segment 0"}]
+    state = json.loads((tmp_path / "transport_state.json").read_text())
+    assert state["status"] == "infra" and state["iters"] == 5
+
+
+@pytest.mark.parametrize("kind", ["handoff", "free"])
+def test_stalled_segments_share_configured_work_clock(
+        tmp_path, monkeypatch, kind):
+    calls, run = run_phase(tmp_path, monkeypatch, kind,
+                          [{"wall": 2, "pause": 500}, {"wall": 1}], wall=3)
+    with pytest.raises(loop.E15InfrastructureError,
+                       match="not a convergence decision"):
+        run()
+    assert [c["wall_budget"] for c in calls] == [3, 1]
+    state = json.loads((tmp_path / "transport_state.json").read_text())
+    assert state["wall_secs"] == 3
+
+
+@pytest.mark.parametrize("kind", ["handoff", "free"])
+def test_actor_has_no_new_actionless_segment_limit(tmp_path, monkeypatch, kind):
+    steps = [{} for _ in range(4)] + [{"status": "done", "publish": True}]
+    calls, run = run_phase(tmp_path, monkeypatch, kind, steps)
+    run()
+    assert len(calls) == 5
+    assert [c["iters_budget"] for c in calls] == [20, 19, 18, 17, 16]
+    assert not (tmp_path / "transport_state.json").exists()
+
+
+@pytest.mark.parametrize("kind", ["handoff", "free"])
+def test_valid_completion_at_watchdog_boundary_is_preserved(
+        tmp_path, monkeypatch, kind):
+    # A canonical handoff can coincide with a segment stall; it already wins
+    # over the status in the release protocol and must still do so here.
+    status = "stalled" if kind == "handoff" else "done"
+    calls, run = run_phase(
+        tmp_path, monkeypatch, kind,
+        [{"iters": 2}, {"iters": 1, "status": status, "publish": True}],
+        max_iters=3)
+    run()
+    assert [c["iters_budget"] for c in calls] == [3, 1]
+    assert not (tmp_path / "transport_state.json").exists()
+
+
+@pytest.mark.parametrize("kind", ["handoff", "free"])
+def test_progress_does_not_reset_the_existing_emergency_budget(
+        tmp_path, monkeypatch, kind):
+    calls, run = run_phase(
+        tmp_path, monkeypatch, kind,
+        [{"iters": 3, "programs": 2}, {"iters": 2, "programs": 1}],
+        max_iters=5)
+    with pytest.raises(loop.E15InfrastructureError):
+        run()
+    assert [c["iters_budget"] for c in calls] == [5, 2]
+
+
+def test_curriculum_retry_preserves_draft_and_consumes_cumulative_budget(tmp_path, monkeypatch):
+    import re
+    from config.settings import Config
+    from core.loop import LoopResult
+    from explore import e15_loop as loop
+    guest = {"handoff": "", "draft": "expensive original inputs"}
+    calls = []
+    monkeypatch.setattr(loop, "_remove_guest_file", lambda *a: guest.update(handoff=""))
+    monkeypatch.setattr(loop, "_remove_incomplete_curriculum_project", lambda *a: pytest.fail("erased draft"))
+    def attempt(prompt, vm, cfg, sink, **kw):
+        calls.append(kw)
+        if len(calls) == 2:
+            assert guest["draft"] == "expensive original inputs"
+            assert kw["iters_budget"] == 19 and kw["wall_budget"] == 58
+            guest["handoff"] = "ready"
+        return LoopResult(status="done" if len(calls) == 2 else "stalled",
+                          iters=1, programs_run=1, wall_secs=2), []
+    hooks = loop.E15Hooks(run_attempt=attempt, audit_text=lambda *a, **k: [],
+                         audit_transcripts=lambda *a, **k: [],
+                         read_guest_text=lambda *a: guest["handoff"])
+    parsed, _, _ = loop._run_handoff_phase(
+        hooks=hooks, vm=object(), cfg=Config(max_iters=20, wall_clock_secs=60),
+        prompt="public instruction", role="CURRICULUM", handoff_path="handoff",
+        token_pattern=re.compile(".*"), sink_root=str(tmp_path / "curriculum"),
+        target="public instruction", require_completed_publication=True,
+        handoff_parser=lambda text, _: loop.ParsedHandoff("PROJECT", text, text) if text else None)
+    assert parsed.token == "PROJECT" and len(calls) == 2
+
